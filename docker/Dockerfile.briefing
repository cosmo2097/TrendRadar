FROM python:3.10-slim

WORKDIR /app

# 安装 briefing 专属依赖（与其他服务依赖隔离）
COPY requirements.briefing.txt .
RUN pip install --no-cache-dir -r requirements.briefing.txt -i https://mirrors.aliyun.com/pypi/simple/ \
    && python - <<'PY'
from importlib.metadata import version
print("mcp:", version("mcp"))
print("anyio:", version("anyio"))
PY

# 复制 Briefing Server 代码
COPY briefing_server/ ./briefing_server/
# 复制 trendradar 核心模块 (依赖)
COPY trendradar/ ./trendradar/

# 创建必要目录
RUN mkdir -p /app/config /app/output

ENV PYTHONUNBUFFERED=1 \
    CONFIG_PATH=/app/config/config.yaml \
    FREQUENCY_WORDS_PATH=/app/config/frequency_words.txt

# Briefing Server 端口
EXPOSE 8000

# 启动 Briefing Server
CMD ["python", "-m", "briefing_server.main"]
