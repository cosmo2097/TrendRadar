      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stats\": [],\n  \"rss_stats\": [],\n  \"ai_model\": null,\n  \"stream\": true,\n  \"date_range\": \"daily\"\n}"
        },
        "url": {
