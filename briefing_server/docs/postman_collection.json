          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stats\": [],\n  \"rss_stats\": [],\n  \"ai_model\": null,\n  \"stream\": false,\n  \"date_range\": \"daily\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/briefing/analyze",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
