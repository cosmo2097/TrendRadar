            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "text/event-stream"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rules\": [],\n  \"preset\": \"AI\",\n  \"allowed_sources\": null,\n  \"custom_rss_urls\": null,\n  \"stream\": true,\n  \"ai_model\": null,\n  \"date_range\": \"daily\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/briefing",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "briefing"
          ]
        }
      }
    },
